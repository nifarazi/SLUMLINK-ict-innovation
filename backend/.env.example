SERVER_PORT=5001

SUPABASE_PROJECT_REF=YOUR_PROJECT_REF
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Use Session Pooler (port 5432) for persistent Node.js hosting over IPv4.
# Percent-encode reserved characters in the database password.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PERCENT_ENCODED_PASSWORD@YOUR_POOLER_HOST:5432/postgres?uselibpqcompat=true&sslmode=require

APP_BASE_URL=https://your-hosted-domain.example
EMAIL_USER=your-email@example.com
EMAIL_PASSWORD=your-email-app-password
BULKSMS_API_KEY=your-sms-api-key
BULKSMS_SENDER_ID=your-sms-sender-id
